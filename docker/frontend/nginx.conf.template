map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

map $http_x_forwarded_proto $forwarded_scheme {
  default $http_x_forwarded_proto;
  '' $scheme;
}

# Browsers omit Origin on same-origin GETs; authenticated backend routes check it.
map $http_origin $upstream_origin {
  default $http_origin;
  '' "$forwarded_scheme://$http_host";
}

server {
  listen ${NGINX_PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 50m;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location = /health {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok"}';
  }

  location = /config.js {
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }

  location /api/ {
    resolver 127.0.0.11 valid=30s;
    set $backend http://${BACKEND_UPSTREAM};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $upstream_origin;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_scheme;
    proxy_set_header X-Forwarded-Prefix /api;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
