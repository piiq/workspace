# Copy to docker/.env and replace the secrets and provisioning path.
WORKSPACE_CONFIG_DIR=/absolute/path/to/account-config
WORKSPACE_PORT=8080
MODE=onprem
DATABASE_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=workspace
READ_DB_USER=root
READ_DB_PASSWORD=replace-with-database-password
WRITE_DB_USER=root
WRITE_DB_PASSWORD=replace-with-database-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
JWT_SECRET=replace-with-a-long-random-secret
OPENBB_AES_KEY=replace-with-32-character-aes-key!
LOCAL_STORAGE_SECRET_KEY=replace-with-a-long-random-secret
SELFURL=http://localhost:8080/api
FRONTENDURL=http://localhost:8080
PROURL=http://localhost:8080
BACKEND_CORS_ORIGINS=["http://localhost:8080"]
STORAGE_PROVIDER=folder
FOLDER_STORAGE_PATH=/data/storage
EMAIL_PROVIDER=none
HUBSPOT=false
PROMETHEUS=false
WORKERS=1
DISABLE_REGISTRATION=true
