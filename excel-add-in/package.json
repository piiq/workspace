{
  "name": "excel-add-in",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExtraBB/Office-Addin-React-Vite-Template.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 1420
  },
  "scripts": {
    "build": "tsc && vite build && npm run validate",
    "dev": "vite --port 1420",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "office-addin-lint prettier",
    "preview": "vite preview",
    "start": "office-addin-debugging start dist/manifest.xml",
    "start:desktop": "office-addin-debugging start dist/manifest.xml desktop",
    "start:web": "office-addin-debugging start dist/manifest.xml web",
    "stop": "office-addin-debugging stop dist/manifest.xml",
    "validate": "office-addin-manifest validate dist/manifest.xml",
    "generate": "python ./src/functions/generator/ts_generator.py",
    "generate:update": "python ./src/functions/generator/ts_generator.py --update",
    "office:clear-mac": "rm -rf ~/Library/Containers/com.microsoft.Excel",
    "office:tools-mac": "defaults write com.microsoft.Excel OfficeWebAddinDeveloperExtras -bool true",
    "test": "jest --silent --verbose",
    "test:unit": "jest --silent --verbose --selectProjects=unit",
    "test:integration-full": "jest --silent --verbose --selectProjects=integration-full",
    "test:integration-smoke": "jest --silent --verbose --selectProjects=integration-smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@openbb/ui": "^0.14.17",
    "@radix-ui/react-tooltip": "^1.4.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "dayjs": "^1.11.23",
    "dayjs-business-days2": "^1.4.0",
    "moment-timezone": "^0.6.6",
    "posthog-js": "^1.444.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/custom-functions-runtime": "^1.6.13",
    "@types/jest": "^30.0.0",
    "@types/office-js": "^1.0.615",
    "@types/office-runtime": "^1.0.40",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "custom-functions-metadata": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "office-addin-cli": "^3.0.1",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "office-addin-mock": "^4.0.1",
    "office-addin-prettier-config": "^3.0.1",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-markdown": "^3.0.0-2"
  },
  "overrides": {
    "zod": "$zod",
    "adm-zip": "^0.6.1",
    "striptags": "^3.2.0",
    "toml": "^5.0.1",
    "glob@>=9": "^14.0.2",
    "minimatch@>=9": "^11.0.1"
  }
}
